# AstroDaily configuration template
# This file is documentation, not a production secret store. Every
# REPLACE_WITH_* value is intentionally rejected by production validation.

# === App Configuration ===
APP_ENV=prod
APP_NAME=astrodaily
APP_HOST=0.0.0.0
APP_PORT=8080
DEBUG=false

# === Skyfield Ephemeris ===
ASTRO_EPHEMERIS_DIR=/app/data/ephemeris
ASTRO_EPHEMERIS_FILE=de440s.bsp

# === Database ===
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=astrodaily
POSTGRES_USER=astrodaily
# DATABASE_URL takes precedence when non-empty. Keep it empty to use POSTGRES_*.
DATABASE_URL=
POSTGRES_PASSWORD=REPLACE_WITH_PRODUCTION_POSTGRES_PASSWORD

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=REPLACE_WITH_PRODUCTION_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_PRODUCTION_TELEGRAM_WEBHOOK_SECRET

# Comma-separated hostname patterns; schemes, paths, ports, and * are rejected.
TRUSTED_HOSTS=app.example.invalid

# Pilot trust-boundary flags. No internal routes are mounted by these settings.
ENABLE_INTERNAL_API=false
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_PRODUCTION_INTERNAL_SERVICE_TOKEN
SCHEDULED_DELIVERY_ENABLED=false

# === Stripe (optional; not required for the pilot startup contract) ===
STRIPE_SECRET_KEY=REPLACE_WITH_OPTIONAL_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_OPTIONAL_STRIPE_WEBHOOK_SECRET

# === Geocoding / Timezone ===
# Режимы: stub (для разработки) | chain (nominatim + fallback) | nominatim | google
GEOCODER_MODE=chain
GEOCODER_CACHE_TTL_DAYS=3650

# Nominatim options:
# - Для self-hosted: http://nominatim:8080 (если запущен nominatim контейнер)
# - Для публичного API: https://nominatim.openstreetmap.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_TIMEOUT_S=5

# Google Geocoding API (опционально, как fallback)
GOOGLE_GEOCODING_API_KEY=
GOOGLE_GEOCODING_TIMEOUT_S=5

# === LLM (Quality Content / digest enhancement) ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_ENABLED=false
LLM_CACHE_TTL_DAYS=7
LLM_MAX_DAILY_COST_USD=10.0
LLM_MAX_MONTHLY_COST_USD=200.0

# A/B тест: доля пользователей (0–100), получающих LLM-дайджест при подходящих условиях
AB_DIGEST_LLM_PERCENT=50
