# AstroDaily — Production Environment Configuration Template
# Copy this file to .env and fill in actual values

# === App Configuration ===
APP_ENV=prod
APP_NAME=astrodaily
APP_HOST=0.0.0.0
APP_PORT=8080
DEBUG=false

# === Skyfield Ephemeris ===
ASTRO_EPHEMERIS_DIR=/app/data/ephemeris
ASTRO_EPHEMERIS_FILE=de440s.bsp

# === Database ===
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=astrodaily
POSTGRES_USER=astrodaily
POSTGRES_PASSWORD=*********CHANGE_ME_IN_PROD*********

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=*********REPLACE_WITH_YOUR_BOT_TOKEN_FROM_BOTFATHER*********

# === Stripe (для монетизации) ===
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# === Geocoding / Timezone ===
# Режимы: stub (для разработки) | chain (nominatim + fallback) | nominatim | google
GEOCODER_MODE=chain
GEOCODER_CACHE_TTL_DAYS=3650

# Nominatim options:
# - Для self-hosted: http://nominatim:8080 (если запущен nominatim контейнер)
# - Для публичного API: https://nominatim.openstreetmap.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_TIMEOUT_S=5

# Google Geocoding API (опционально, как fallback)
GOOGLE_GEOCODING_API_KEY=
GOOGLE_GEOCODING_TIMEOUT_S=5
